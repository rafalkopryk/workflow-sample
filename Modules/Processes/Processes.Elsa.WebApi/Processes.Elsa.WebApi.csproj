<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Elsa's Blazor components come from package/RCL assemblies, so this
             host has no local .razor file to trigger ASP.NET web assets. -->
        <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Elsa" />
        <PackageReference Include="Elsa.Workflows.Core" />
        <PackageReference Include="Elsa.Workflows.Management" />
        <PackageReference Include="Elsa.Workflows.Runtime" />
        <PackageReference Include="Elsa.Workflows.Runtime.Distributed" />
        <PackageReference Include="Elsa.Workflows.Api" />
        <PackageReference Include="Elsa.Persistence.EFCore.Sqlite" />
        <PackageReference Include="Elsa.Http" />
        <PackageReference Include="Elsa.Scheduling" />
        <PackageReference Include="Elsa.Expressions.CSharp" />
        <PackageReference Include="Elsa.Expressions.JavaScript" />
        <PackageReference Include="Elsa.Expressions.Liquid" />
        <PackageReference Include="Elsa.Dsl.ElsaScript" />
        <PackageReference Include="Elsa.WorkflowProviders.BlobStorage" />
        <PackageReference Include="Elsa.WorkflowProviders.BlobStorage.ElsaScript" />
        <PackageReference Include="Elsa.Shells.Api" />
        <PackageReference Include="CShells.AspNetCore" />
        <PackageReference Include="CShells.FastEndpoints" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
        <PackageReference Include="Elsa.Studio" />
        <PackageReference Include="Elsa.Studio.Core.BlazorServer" />
        <PackageReference Include="Elsa.Studio.Translations" />
        <PackageReference Include="Elsa.Studio.Shell" />
        <PackageReference Include="Elsa.Studio.Dashboard" />
        <PackageReference Include="Elsa.Studio.Localization.BlazorServer" />
        <PackageReference Include="Elsa.Studio.Workflows" />
        <PackageReference Include="Elsa.Studio.Workflows.Designer" />
        <PackageReference Include="WolverineFx" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="App_Data\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Common\Common.Application\Common.Application.csproj" />
      <ProjectReference Include="..\..\Applications\Applications.Contracts\Applications.Contracts.csproj" />
      <ProjectReference Include="..\..\Aspire\Aspire\Aspire.ServiceDefaults\Aspire.ServiceDefaults.csproj" />
      <ProjectReference Include="..\..\Calculations\Calculations.Contracts\Calculations.Contracts.csproj" />
    </ItemGroup>
</Project>
